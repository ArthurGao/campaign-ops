{
  "name": "campaign-ops",
  "private": true,
  "version": "0.1.0",
  "description": "CampaignOps \u2014 media promotion operations console (phase 1 clickable demo)",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @campaign-ops/frontend run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:full": "pnpm --parallel --filter @campaign-ops/backend --filter @campaign-ops/frontend run dev:http",
    "build:frontend": "pnpm --filter @campaign-ops/frontend run build",
    "e2e": "pnpm --filter @campaign-ops/frontend run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
